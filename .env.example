# ---------------------------------------------------------------------------
# EmailJS — powers the contact form (client-side, no backend).
# Create a free account at https://www.emailjs.com/ then:
#   1. Add an Email Service   -> copy the Service ID
#   2. Create an Email Template with variables: {{from_name}}, {{reply_to}}, {{message}}
#      (set the template "To" field to your own inbox, and "Reply-To" to {{reply_to}})
#      -> copy the Template ID
#   3. Account -> General -> copy your Public Key
#
# These are NEXT_PUBLIC_* on purpose: EmailJS keys are designed to be public and
# ship to the browser. The honeypot field provides basic spam protection.
# Copy this file to `.env.local` and fill in the real values (never commit .env.local).
# ---------------------------------------------------------------------------

NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# ---------------------------------------------------------------------------
# Anthropic (Claude) — powers the "Improve with AI" button on the contact form.
# SERVER-SIDE ONLY: no NEXT_PUBLIC_ prefix, so the key never reaches the browser.
# OPTIONAL: leave blank and the AI button is hidden — the form still works fully.
#   - Get a key at https://console.anthropic.com/ (has trial credits).
#   - Each click makes one paid API call, so keep a low spend limit on the key
#     and rely on the built-in rate limiting (see src/app/api/improve-message).
#   - ANTHROPIC_MODEL is optional; claude-haiku-4-5 is much cheaper/faster for
#     this simple rewrite than the default claude-opus-4-8.
# ---------------------------------------------------------------------------

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Set to "true" to SHOW the "Improve with AI" button on the contact form.
# This one is NEXT_PUBLIC (it only controls button visibility, not the key).
# Turn it on only after you've set ANTHROPIC_API_KEY above.
NEXT_PUBLIC_AI_ENABLED=false
